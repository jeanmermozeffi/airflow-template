# Configuration DevOps pour airflow-project
# Copiez ce fichier vers .devops.yml et configurez-le

project_name: airflow-project
stack_type: orchestrator
compose_project_name: airflow-project
label_namespace: cic

# Orchestrator / Airflow
airflow_version: 3.1.5
airflow_base_image: apache/airflow:3.1.5-python3.11
release_multiarch: false
release_platforms: linux/amd64

registry_username: your-dockerhub-username
registry_url: docker.io
image_name: airflow-project

# Structure du projet (tout le code métier est dans src/)
app_source_dir: src
app_dest_dir: src
requirements_path: requirements.txt
workdir: /app

git_repo: https://github.com/votre-org/airflow-project.git
github_token: # Optionnel

dev_branch: dev
staging_branch: staging
prod_branch: main

# Ports (optionnel)
dev_port: 8001
staging_port: 8002
prod_port: 8000
redis_dev_port: 6379
redis_staging_port: 6381
redis_prod_port: 6380
